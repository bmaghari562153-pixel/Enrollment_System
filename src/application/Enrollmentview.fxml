<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    prefHeight="700.0"
    prefWidth="900.0"
    style="-fx-background-color: #1a1a2e;"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="application.EnrollmentController">

   <!-- TOP BAR -->
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="48.0" prefWidth="900.0"
            styleClass="topbar" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="brand-label" text="  Enrollment System" />
         </children>
      </HBox>
   </top>

   <!-- SIDEBAR -->
   <left>
      <VBox prefHeight="652.0" prefWidth="200.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#showDashBoard"   prefHeight="50.0" prefWidth="200.0" styleClass="nav-btn"             text="Dashboard" />
            <Button mnemonicParsing="false" onAction="#showStudents"    prefHeight="50.0" prefWidth="200.0" styleClass="nav-btn"             text="Students" />
            <Button mnemonicParsing="false" onAction="#showCourses"     prefHeight="50.0" prefWidth="200.0" styleClass="nav-btn"             text="Courses" />
            <Button mnemonicParsing="false" onAction="#showEnrollments" prefHeight="50.0" prefWidth="200.0" styleClass="nav-btn, nav-active" text="Enrollments" />
            <Button mnemonicParsing="false" onAction="#showSchedule"    prefHeight="50.0" prefWidth="200.0" styleClass="nav-btn"             text="Schedule" />
         </children>
      </VBox>
   </left>

   <!-- MAIN CONTENT -->
   <center>
      <ScrollPane fitToWidth="true"
          style="-fx-background: #1a1a2e; -fx-background-color: #1a1a2e; -fx-border-color: transparent;">
         <content>
            <VBox prefWidth="680.0" spacing="16" styleClass="main-content">
               <children>

                  <Label styleClass="page-title" text="Enrollments" />

                  <!-- Search bar -->
                  <HBox alignment="CENTER_LEFT" spacing="10">
                     <children>
                        <TextField fx:id="searchField" prefWidth="340.0" styleClass="text-field" />
                        <Button onAction="#searchEnrollment"  prefWidth="90.0"  styleClass="btn-primary"   text="Search" />
                        <Button onAction="#clearForm"         prefWidth="80.0"  styleClass="btn-secondary" text="Clear" />
                     </children>
                  </HBox>

                  <!-- Enroll student card -->
                  <VBox spacing="12" styleClass="card">
                     <children>
                        <Label styleClass="card-title" text="Enroll / update student" />

                        <!-- Row 1: Student ID + Course code -->
                        <HBox spacing="12">
                           <children>
                              <VBox prefWidth="240.0" spacing="4">
                                 <children>
                                    <Label styleClass="form-label" text="Student ID" />
                                    <TextField fx:id="studentIdField" styleClass="text-field" />
                                 </children>
                              </VBox>
                              <VBox prefWidth="240.0" spacing="4">
                                 <children>
                                    <Label styleClass="form-label" text="Course code" />
                                    <TextField fx:id="courseCodeField" styleClass="text-field" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <!-- Row 2: Status ComboBox -->
                        <HBox spacing="12" alignment="CENTER_LEFT">
                           <children>
                              <VBox prefWidth="220.0" spacing="4">
                                 <children>
                                    <Label styleClass="form-label" text="Status" />
                                    <ComboBox fx:id="statusComboBox" prefWidth="220.0" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <!-- Validation banner -->
                        <HBox fx:id="validationBanner" alignment="CENTER_LEFT" spacing="8"
                              style="-fx-background-color: #0f3460; -fx-background-radius: 8; -fx-padding: 10;">
                           <children>
                              <Label fx:id="validationIcon"    text="ℹ" style="-fx-text-fill: #60a5fa; -fx-font-size: 14px;" />
                              <Label fx:id="validationMessage" text="Enter a Student ID and Course code, then click Validate."
                                     style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" wrapText="true" />
                           </children>
                        </HBox>

                        <!-- Buttons -->
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                           <children>
                              <Button onAction="#handleValidate"      prefWidth="100.0" styleClass="btn-secondary" text="Validate" />
                              <Button onAction="#handleEnroll"        prefWidth="100.0" styleClass="btn-primary"   text="Enroll" />
                              <Button onAction="#handleUpdateStatus"  prefWidth="130.0" styleClass="btn-secondary" text="Update Status" />
                              <Button onAction="#handleDrop"          prefWidth="100.0" styleClass="btn-danger"    text="Drop" />
                           </children>
                        </HBox>

                        <Label fx:id="statusLabel" text="" />
                     </children>
                  </VBox>

                  <!-- Enrollment records table -->
                  <VBox spacing="10" styleClass="card">
                     <children>
                        <Label styleClass="card-title" text="Enrollment records" />
                        <TableView fx:id="enrollmentTable" prefHeight="220.0" prefWidth="640.0" styleClass="styled-table">
                           <columns>
                              <TableColumn fx:id="colStudentId"   prefWidth="110.0" text="Student ID" />
                              <TableColumn fx:id="colStudentName" prefWidth="155.0" text="Student name" />
                              <TableColumn fx:id="colCourseCode"  prefWidth="80.0"  text="Course" />
                              <TableColumn fx:id="colCourseName"  prefWidth="175.0" text="Course name" />
                              <TableColumn fx:id="colStatus"      prefWidth="100.0" text="Status" />
                           </columns>
                           <placeholder>
                              <Label styleClass="table-placeholder" text="No enrollment records found." />
                           </placeholder>
                        </TableView>
                     </children>
                  </VBox>

               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>

</BorderPane>

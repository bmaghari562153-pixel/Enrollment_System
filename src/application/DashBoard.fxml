<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    prefHeight="700.0"
    prefWidth="900.0"
    style="-fx-background-color: #1a1a2e;"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="application.DashBoardController">

  
   <top>
      <HBox
          prefHeight="48.0"
          prefWidth="900.0"
          styleClass="topbar"
          alignment="CENTER_LEFT"
          BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="brand-label" text="  Enrollment System" />
         </children>
      </HBox>
   </top>


   <left>
      <VBox
          prefHeight="652.0"
          prefWidth="200.0"
          styleClass="sidebar"
          BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#showDashBoard"   prefHeight="50.0" prefWidth="200.0" styleClass="nav-btn, nav-active" text="Dashboard" />
            <Button mnemonicParsing="false" onAction="#showStudents"    prefHeight="50.0" prefWidth="200.0" styleClass="nav-btn"             text="Students" />
            <Button mnemonicParsing="false" onAction="#showCourses"     prefHeight="50.0" prefWidth="200.0" styleClass="nav-btn"             text="Courses" />
            <Button mnemonicParsing="false" onAction="#showEnrollments" prefHeight="50.0" prefWidth="200.0" styleClass="nav-btn"             text="Enrollments" />
            <Button mnemonicParsing="false" onAction="#showSchedule"    prefHeight="50.0" prefWidth="200.0" styleClass="nav-btn"             text="Schedule" />
         </children>
      </VBox>
   </left>

  
   <center>
      <VBox
          prefWidth="680.0"
          spacing="16"
          styleClass="main-content"
          BorderPane.alignment="CENTER">
         <children>

            <Label styleClass="page-title" text="Overview" />

           
            <HBox prefHeight="100.0" spacing="12">
               <children>
                  <VBox prefWidth="140.0" styleClass="stat-card">
                     <children>
                        <Label styleClass="stat-label" text="Students" />
                        <Label fx:id="studentCountLabel" styleClass="stat-value" text="0" />
                     </children>
                  </VBox>
                  <VBox prefWidth="140.0" styleClass="stat-card">
                     <children>
                        <Label styleClass="stat-label" text="Courses" />
                        <Label fx:id="coursesCountLabel" styleClass="stat-value" text="0" />
                     </children>
                  </VBox>
                  <VBox prefWidth="140.0" styleClass="stat-card">
                     <children>
                        <Label styleClass="stat-label" text="Enrolled" />
                        <Label fx:id="enrolledCountLabel" styleClass="value-success" text="0" />
                     </children>
                  </VBox>
                  <VBox prefWidth="140.0" styleClass="stat-card">
                     <children>
                        <Label styleClass="stat-label" text="Pending" />
                        <Label fx:id="pendingCountLabel" styleClass="value-warning" text="0" />
                     </children>
                  </VBox>
               </children>
            </HBox>

          
            <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
               <children>
                  <Label styleClass="card-title" text="Recent enrollments" />
                  <TableView
                      fx:id="recentTable"
                      prefHeight="440.0"
                      prefWidth="640.0"
                      styleClass="styled-table"
                      VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="studentCol" prefWidth="213.0" text="Student ID" />
                        <TableColumn fx:id="courseCol"  prefWidth="213.0" text="Course" />
                        <TableColumn fx:id="statusCol"  prefWidth="213.0" text="Status" />
                     </columns>
                     <placeholder>
                        <Label styleClass="table-placeholder" text="No enrollment records." />
                     </placeholder>
                  </TableView>
               </children>
            </VBox>

         </children>
      </VBox>
   </center>

</BorderPane>

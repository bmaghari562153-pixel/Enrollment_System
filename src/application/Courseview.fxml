<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    prefHeight="700.0"
    prefWidth="900.0"
    style="-fx-background-color: #1a1a2e;"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="application.CourseController">


   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="48.0" prefWidth="900.0"
            styleClass="topbar" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="brand-label" text="  Enrollment System" />
         </children>
      </HBox>
   </top>

  
   <left>
      <VBox prefHeight="652.0" prefWidth="200.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#showDashBoard"   prefHeight="50.0" prefWidth="200.0" styleClass="nav-btn"             text="Dashboard" />
            <Button mnemonicParsing="false" onAction="#showStudents"    prefHeight="50.0" prefWidth="200.0" styleClass="nav-btn"             text="Students" />
            <Button mnemonicParsing="false" onAction="#showCourses"     prefHeight="50.0" prefWidth="200.0" styleClass="nav-btn, nav-active" text="Courses" />
            <Button mnemonicParsing="false" onAction="#showEnrollments" prefHeight="50.0" prefWidth="200.0" styleClass="nav-btn"             text="Enrollments" />
            <Button mnemonicParsing="false" onAction="#showSchedule"    prefHeight="50.0" prefWidth="200.0" styleClass="nav-btn"             text="Schedule" />
         </children>
      </VBox>
   </left>

  
   <center>
      <ScrollPane fitToWidth="true"
          style="-fx-background: #1a1a2e; -fx-background-color: #1a1a2e; -fx-border-color: transparent;">
         <content>
            <VBox prefWidth="680.0" spacing="16" styleClass="main-content">
               <children>

                  <Label styleClass="page-title" text="Courses" />

                 
                  <HBox alignment="CENTER_LEFT" spacing="10">
                     <children>
                        <TextField fx:id="searchField" prefWidth="340.0" styleClass="text-field" />
                        <Button onAction="#searchCourse" prefWidth="90.0"  styleClass="btn-primary"   text="Search" />
                        <Button onAction="#clearForm"    prefWidth="80.0"  styleClass="btn-secondary" text="Clear" />
                     </children>
                  </HBox>

                  
                  <VBox spacing="12" styleClass="card">
                     <children>
                        <Label styleClass="card-title" text="Add / edit course" />

                       
                        <HBox spacing="12">
                           <children>
                              <VBox prefWidth="140.0" spacing="4">
                                 <children>
                                    <Label styleClass="form-label" text="Course code" />
                                    <TextField fx:id="courseCodeField" styleClass="text-field" />
                                 </children>
                              </VBox>
                              <VBox prefWidth="80.0" spacing="4">
                                 <children>
                                    <Label styleClass="form-label" text="Units" />
                                    <TextField fx:id="unitsField" styleClass="text-field" />
                                 </children>
                              </VBox>
                              <VBox prefWidth="340.0" spacing="4">
                                 <children>
                                    <Label styleClass="form-label" text="Course name" />
                                    <TextField fx:id="courseNameField" styleClass="text-field" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                       
                        <HBox spacing="12">
                           <children>
                              <VBox prefWidth="150.0" spacing="4">
                                 <children>
                                    <Label styleClass="form-label" text="Day" />
                                    <ComboBox fx:id="dayComboBox" prefWidth="150.0" />
                                 </children>
                              </VBox>
                              <VBox prefWidth="180.0" spacing="4">
                                 <children>
                                    <Label styleClass="form-label" text="Start time" />
                                    <TextField fx:id="startTimeField" styleClass="text-field" />
                                 </children>
                              </VBox>
                              <VBox prefWidth="180.0" spacing="4">
                                 <children>
                                    <Label styleClass="form-label" text="End time" />
                                    <TextField fx:id="endTimeField" styleClass="text-field" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        
                        <VBox spacing="4">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="8">
                                 <children>
                                    <Label styleClass="form-label" text="Prerequisites" />
                                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px;"
                                           text="(hold Ctrl to select multiple)" />
                                 </children>
                              </HBox>
                              <ListView
                                  fx:id="prerequisitesList"
                                  prefHeight="120.0"
                                  prefWidth="640.0"
                                  style="-fx-background-color: #0f3460;
                                         -fx-border-color: #1d4ed8;
                                         -fx-border-radius: 6;
                                         -fx-background-radius: 6;
                                         -fx-control-inner-background: #0f3460;
                                         -fx-font-size: 13px;" />
                           </children>
                        </VBox>

                     
                        <HBox alignment="CENTER_RIGHT" spacing="10">
                           <children>
                              <Button onAction="#saveCourse"   prefWidth="100.0" styleClass="btn-primary" text="Save" />
                              <Button onAction="#deleteCourse" prefWidth="100.0" styleClass="btn-danger"  text="Delete" />
                           </children>
                        </HBox>

                        <Label fx:id="statusLabel" text="" />
                     </children>
                  </VBox>

                 
                  <VBox spacing="10" styleClass="card">
                     <children>
                        <Label styleClass="card-title" text="Course list" />
                        <TableView fx:id="courseTable" prefHeight="220.0" prefWidth="640.0" styleClass="styled-table">
                           <columns>
                              <TableColumn fx:id="codeCol"     prefWidth="90.0"  text="Code" />
                              <TableColumn fx:id="nameCol"     prefWidth="210.0" text="Course name" />
                              <TableColumn fx:id="unitsCol"    prefWidth="60.0"  text="Units" />
                              <TableColumn fx:id="dayCol"      prefWidth="80.0"  text="Day" />
                              <TableColumn fx:id="scheduleCol" prefWidth="190.0" text="Schedule" />
                           </columns>
                           <placeholder>
                              <Label styleClass="table-placeholder" text="No courses found." />
                           </placeholder>
                        </TableView>
                     </children>
                  </VBox>

               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>

</BorderPane>
